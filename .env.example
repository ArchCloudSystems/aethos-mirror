# Aethos Mirror — example environment template
#
# Copy this file to .env.local and fill in your own values there.
# .env.local is git-ignored. NEVER put real secrets in this file.
# Every secret/key/token below is intentionally left EMPTY.
# See docs/getting-started/provider-setup.md for how to obtain each value.

# Mirror device / runtime
AETHOS_MIRROR_DEVICE_ID=aethos-mirror
AETHOS_MIRROR_DEVICE_NAME="Aethos Mirror"
AETHOS_MIRROR_PORT=3055
AETHOS_MIRROR_DEFAULT_LOCATION="Your City, ST"
AETHOS_MIRROR_DEFAULT_LAT=0.0000
AETHOS_MIRROR_DEFAULT_LON=0.0000

# Assistant identity (customizable; these are the public defaults)
ASSISTANT_ENABLED=true
ASSISTANT_DISPLAY_NAME=Aethos
ASSISTANT_WAKE_WORD=
ASSISTANT_PERSONALITY_MODE=calm
ASSISTANT_ORB_VISIBLE=true
ASSISTANT_DEFAULT_MODE=landing

# Interface profile: desktop | kiosk | mirror | mobile
INTERFACE_PROFILE=desktop

# LLM provider: none | demo | openai | openai-compatible | anthropic |
#               gemini | ollama | custom
# demo/none work without any API keys.
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Anthropic (BYOK — put real key in .env.local)
ANTHROPIC_API_KEY=

# Gemini (BYOK — put real key in .env.local)
GEMINI_API_KEY=

# Telegram (BYOK — put real token/chat IDs in .env.local)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_POLLING_ENABLED=false

# ElevenLabs (BYOK — put real key/voice ID in .env.local)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Google OAuth / Workspace (read-only scopes only — secrets in .env.local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3055/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_IDS=primary
GMAIL_SUMMARY_MAX_RESULTS=5

# News Provider (BYOK — put real key in .env.local)
NEWS_PROVIDER=newsapi
NEWS_API_KEY=
NEWS_COUNTRY=us
NEWS_CATEGORY=technology
NEWS_QUERY=

# Weather Provider (BYOK — put real key in .env.local)
WEATHER_PROVIDER=openweathermap
OPENWEATHER_API_KEY=
WEATHER_UNITS=imperial

# Map (OpenStreetMap — no API key required)
MAP_PROVIDER=openstreetmap
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION="© OpenStreetMap contributors"

# Optional assistant bridge (disabled by default)
ASSISTANT_BRIDGE_ENABLED=false
ASSISTANT_BRIDGE_BASE_URL=http://127.0.0.1:3001
ASSISTANT_BRIDGE_TOKEN=
