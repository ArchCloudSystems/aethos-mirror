# Aethos Mirror / Ailee Runtime
AETHOS_MIRROR_DEVICE_ID=mothership-main-display
AETHOS_MIRROR_DEVICE_NAME="Mothership Command Display"
AETHOS_MIRROR_PORT=3055
AETHOS_MIRROR_DEFAULT_LOCATION="San Diego, CA"
AETHOS_MIRROR_DEFAULT_LAT=32.7157
AETHOS_MIRROR_DEFAULT_LON=-117.1611

# Ailee Assistant
AILEE_ENABLED=true
AILEE_WAKE_WORD=Ailee
AILEE_DISPLAY_NAME=Ailee
AILEE_DEFAULT_MODE=landing

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_POLLING_ENABLED=false

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Google OAuth / Workspace
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3055/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_IDS=primary
GMAIL_SUMMARY_MAX_RESULTS=5

# News Provider
NEWS_PROVIDER=newsapi
NEWS_API_KEY=
NEWS_COUNTRY=us
NEWS_CATEGORY=technology
NEWS_QUERY=

# Weather Provider
WEATHER_PROVIDER=openweathermap
OPENWEATHER_API_KEY=
WEATHER_UNITS=imperial

# Map
MAP_PROVIDER=openstreetmap
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION="© OpenStreetMap contributors"

# AetherCore bridge later
AETHERCORE_BRIDGE_ENABLED=false
AETHERCORE_BASE_URL=http://127.0.0.1:3001
AETHERCORE_BRIDGE_TOKEN=
